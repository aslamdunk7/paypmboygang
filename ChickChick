-- 1. ฆ่า BAC detection function ที่ใช้ filtergc
local function nukeDetectionFunctions()
    local detected = filtergc("function", {
        Constants = { "gmatch", "GetFullName", "X-14" }
    }, true)
    
    if detected then
        for _, func in ipairs(detected) do
            if islclosure(func) then
                local constants = getconstants(func)
                for i, v in ipairs(constants) do
                    if v == "X-14" then
                        pcall(function()
                            hookfunction(func, function() return nil end)
                        end)
                        break
                    end
                end
            end
        end
    end
end

