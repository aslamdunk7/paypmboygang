-- 3. Humanoid Stealth Swap (ไม่ทิ้งร่องรอย ไม่จมดิน ไม่ค้าง)
local function stealthHumanoidSwap()
    local char = LP.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    -- เก็บ RootPart และตำแหน่งเดิมไว้
    local rootPart = hum.RootPart
    local rootPos = rootPart and rootPart.Position or char.PrimaryPart and char.PrimaryPart.Position or Vector3.new(0, 5, 0)
    local rootCF = rootPart and rootPart.CFrame or CFrame.new(rootPos)

    -- สร้าง Humanoid ใหม่
    local newHum = Instance.new("Humanoid")
    newHum.Name = "Humanoid"
    newHum.WalkSpeed = hum.WalkSpeed
    newHum.JumpPower = hum.JumpPower
    newHum.MaxHealth = hum.MaxHealth
    newHum.Health = hum.Health
    newHum.AutoRotate = hum.AutoRotate
    newHum.PlatformStand = true  -- ป้องกันฟิสิกส์ชนกันตอนสลับ

    -- ย้าย Humanoid เก่าไปไว้ใน char ก่อน
    hum.Parent = nil  -- ถอดออกจาก char โดยไม่ทำลาย
    task.wait(0.05)

    -- ใส่ตัวใหม่
    newHum.Parent = char
    task.wait(0.05)

    -- ตั้ง RootPart ใหม่ (ใช้ตัวเดิมเพื่อไม่ให้จม)
    if rootPart and rootPart.Parent then
        newHum.RootPart = rootPart
    end

    -- ถ้า RootPart ยังไม่ถูกต้อง ให้ขยับตัวละครไปที่ตำแหน่งเดิม
    local primary = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if primary then
        primary.CFrame = rootCF
    end

    -- ปลดล็อคฟิสิกส์
    task.wait(0.1)
    newHum.PlatformStand = false

    -- ตั้ง CameraSubject
    workspace.CurrentCamera.CameraSubject = newHum

    -- ทำลาย Humanoid เก่าทิ้ง (หลังสลับเสร็จ)
    if hum and hum.Parent == nil then
        hum:Destroy()
    end

    print("[PAYOMBOYZ-AC BYPASS] Humanoid swapped — no sink")
end

-- 4. ตรวจจับและบล็อก BAC Event
local function blockBACEvents()
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local remoteModule = replicatedStorage:FindFirstChild("remotesModule")
    
    if remoteModule then
        local success, remotes = pcall(require, remoteModule)
        if success and type(remotes) == "table" then
            local oldFire = remotes.fire
            remotes.fire = function(self, def, ...)
                if def and type(def) == "string" and (def:find("BAC") or def:find("AntiCheat") or def:find("2337")) then
                    return
                end
                return oldFire(self, def, ...)
            end
        end
    end
end

