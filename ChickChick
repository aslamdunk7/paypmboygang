-- ===== FUNC REMOTE SAFE WRAPPER =====
local function safeInvoke(remoteName, ...)
    if not remotesModule then
        warn("[SAE] remotesModule is nil, cannot invoke", remoteName)
        return nil
    end
    local def = remotesModule.defs and remotesModule.defs[remoteName]
    if not def then
        warn("[SAE] Remote def not found:", remoteName)
        return nil
    end
    local success, result = pcall(function()
        return remotesModule.invoke(def, ...)
    end)
    if not success then
        warn("[SAE] Invoke error on", remoteName, ":", result)
        return nil
    end
    return result
end

local function safeFire(remoteName, ...)
    if not remotesModule then
        warn("[SAE] remotesModule is nil, cannot fire", remoteName)
        return
    end
    local def = remotesModule.defs and remotesModule.defs[remoteName]
    if not def then
        warn("[SAE] Remote def not found:", remoteName)
        return
    end
    local success, err = pcall(function()
        remotesModule.fire(def, ...)
    end)
    if not success then
        warn("[SAE] Fire error on", remoteName, ":", err)
    end
end

