local function isRebirthReady()
    if not (dataControllerModule and dataControllerModule.rebirth) then return false end
    local success, rebirthData = pcall(dataControllerModule.rebirth)
    if not success then return false end
    local rebirthCount = rebirthData and rebirthData.count or 0
    local towerBest = 0
    local tbSuccess, tb = pcall(dataControllerModule.towerBest)
    if tbSuccess then towerBest = tb or 0 end
    -- ใช้ logic ง่าย ๆ (ถ้ามี rebirthBonusModule ก็เพิ่ม)
    return towerBest > 0 and rebirthCount < 100 -- fallback
end

