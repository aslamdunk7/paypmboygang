local AutoTower = Tabs.Main:AddToggle("AutoTower", {
    Title = "Auto Tower",
    Default = false
})

AutoTower:OnChanged(function(Value)
    getgenv().autoTowerEnabled = Value

    if Value and remotesModule then
        pcall(hookTowerContinueOffer)
    end

    if Value and not getgenv().autoTowerLoopActive and remotesModule then
        getgenv().autoTowerLoopActive = true

        task.spawn(function()
            local wasWaitingForRebirth = false

            while getgenv().autoTowerEnabled do
                local rebirthPending = false

                if getgenv().autoRebirthEnabled and rebirthBonusModule and rebirthExperimentModule and dataControllerModule then
                    local readySuccess, isReady = pcall(isRebirthReady)

                    rebirthPending = readySuccess and isReady == true
                end

                if rebirthPending then
                    wasWaitingForRebirth = true

                    task.wait(1)
                elseif wasWaitingForRebirth then
                    wasWaitingForRebirth = false

                    task.wait(3)
                elseif isTowerRunActive() then
                    task.wait(1)
                else
                    local towerDelay = tonumber(getgenv().towerDelaySeconds) or 5

                    if towerDelay < 1 then
                        towerDelay = 1
                    end

                    if towerDelay > 60 then
                        towerDelay = 60
                    end

                    task.wait(towerDelay)

                    if getgenv().autoTowerEnabled and not isTowerRunActive() then
                        pcall(startTowerRun)
                    end

                    task.wait(1)
                end
            end

            getgenv().autoTowerLoopActive = false
        end)
    end
end)

local AutoScrap = Tabs.Main:AddToggle("AutoScrap", {
    Title = "Auto Scrap",
    Default = false
})

AutoScrap:OnChanged(function(Value)
    getgenv().autoScrapEnabled = Value

    if Value then
        startScrapNoclip()
    else
        stopScrapNoclip()
    end

    if Value and not getgenv().autoScrapLoopActive then
        getgenv().autoScrapLoopActive = true

        task.spawn(function()
            while getgenv().autoScrapEnabled do
                pcall(function()
                    if getScrapStackCount() > 6 then
                        depositAtRecycler()
                    else
                        collectNearbyScrap()
                    end
                end)

                task.wait(1)
            end

            getgenv().autoScrapLoopActive = false
        end)
    end
end)

